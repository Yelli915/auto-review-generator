# Server-only secret. Never expose this in client code or commit a real value.
GEMINI_API_KEY=

# Required in production. Comma-separated HTTPS origins, e.g. https://example.com,https://www.example.com
ALLOWED_ORIGINS=

# Google OAuth Web Client ID used on the server to verify ID token audience.
GOOGLE_CLIENT_ID=

# Public Google OAuth Web Client ID used by the browser login button.
# This is not a secret, but restrict authorized JavaScript origins in Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=
